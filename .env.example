# Local deployment configuration. Fill values only in .env.local, never here.
# Application runtime (public Supabase values must still match the target project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
# Preserve existing cloud values; do not generate replacements for existing keys.
API_KEY_ENCRYPTION_SECRET=
BACKGROUND_SECRET=
SITE_URL=
# Management credentials and explicit cloud targets; server/local tooling only.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
