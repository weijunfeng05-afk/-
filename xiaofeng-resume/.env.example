# ============================================================
# 小锋牌简历筛选机 —— 环境变量模板
# 复制为 .env.local（本地开发）或在 Netlify 后台逐条配置（线上）。
# ============================================================

# ---------- Supabase（线上必填） ----------
# 项目设置 → API 里的 Project URL 与 anon/publishable key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 服务端事务连接池 URL（通常 6543 端口）；该角色必须能 SET ROLE app_backend。
# 绝对不要加 NEXT_PUBLIC_ 前缀，否则会泄露给浏览器。
DATABASE_URL=
# 服务端专用；用于后台下载简历、校验任务归属、定时恢复。
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 密钥与内部鉴权（线上必填） ----------
# 32 字节随机数据的 Base64，用于 AES-GCM 加密用户自己填写的 API Key。
# 一旦丢失，已保存的个人密钥将无法解密，请做好备份。
API_KEY_ENCRYPTION_SECRET=
# 至少 32 字节随机值，用于 API 与定时函数之间的内部投递鉴权。
BACKGROUND_SECRET=
# 正式站点 HTTPS 源站；Netlify 上会优先使用平台注入的 URL。
SITE_URL=

# ---------- 大模型 ----------
# 可留空：同事各自在「API 设置」里填自己的 DeepSeek Key，按账号加密保存、互不影响。
# 若填写，则作为未自行配置账号的兜底密钥（内测阶段建议留空，避免消耗你的额度）。
DEEPSEEK_API_KEY=
DEEPSEEK_JOB_MODEL=deepseek-v4-pro
DEEPSEEK_RESUME_MODEL=deepseek-flash

# ---------- 运行模式 ----------
# 留空 = 生产模式：使用 Supabase 鉴权 + PostgreSQL + 私有对象存储（线上必须留空）。
#   real / demo = 本地模式：不需要 Supabase，数据存在内存里，重启即清空，仅供本机试用。
# NEXT_PUBLIC_AI_MODE=

# 本地试用用的简易登录（邮箱 + 统一密码）。线上必须删除或设为 false。
# NEXT_PUBLIC_SIMPLE_LOGIN=false
# NEXT_PUBLIC_SIMPLE_PASSWORD=
