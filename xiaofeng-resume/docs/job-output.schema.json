{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "job-output",
  "type": "object",
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 12
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 20
        }
      },
      "required": [
        "summary",
        "responsibilities",
        "keywords"
      ],
      "additionalProperties": false
    },
    "scorecard": {
      "type": "object",
      "properties": {
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "rubric": {
                "type": "string",
                "minLength": 1,
                "maxLength": 800
              }
            },
            "required": [
              "id",
              "name",
              "weight",
              "rubric"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 12
        },
        "must_have": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 15
        },
        "nice_to_have": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 15
        }
      },
      "required": [
        "dimensions",
        "must_have",
        "nice_to_have"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profile",
    "scorecard"
  ],
  "additionalProperties": false
}
